# Copy this file to ../.env. Never commit a real provider key.
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODELS=deepseek-v4-flash,deepseek-v4-pro

# Buyers use this platform key instead of seeing any seller/provider key.
TOKENCOIN_BUYER_API_KEY=replace-with-a-random-local-buyer-key
# Manual canary probes call the upstream and may consume its balance; use a separate operator key.
TOKENCOIN_ADMIN_API_KEY=replace-with-a-different-random-operator-key
TOKENCOIN_BUYER_ID=local-buyer
TOKENCOIN_BUYER_STARTING_MICRO_CNY=10000000
TOKENCOIN_REQUEST_RESERVE_MICRO_CNY=100000
TOKENCOIN_RESERVATION_LEASE_SECONDS=300

# Optional additional OpenAI-compatible supplies. Lower priority is tried first.
# TOKENCOIN_SUPPLIES_JSON=[{"id":"deepseek-backup","name":"DeepSeek backup","provider":"deepseek","base_url":"https://api.deepseek.com","api_key":"replace-with-backup-key","models":["deepseek-v4-flash","deepseek-v4-pro"],"priority":20}]

TOKENCOIN_CONNECT_TIMEOUT_SECONDS=5
TOKENCOIN_READ_TIMEOUT_SECONDS=120
TOKENCOIN_FIRST_BYTE_TIMEOUT_SECONDS=20
TOKENCOIN_CIRCUIT_FAILURE_THRESHOLD=2
TOKENCOIN_CIRCUIT_COOLDOWN_SECONDS=30
TOKENCOIN_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# A tiny model/capability/usage canary runs on startup and every 15 minutes.
TOKENCOIN_SCHEDULED_PROBES_ENABLED=true
TOKENCOIN_PROBE_ON_STARTUP=true
TOKENCOIN_PROBE_INTERVAL_SECONDS=900
TOKENCOIN_PROBE_MODEL=deepseek-v4-flash
TOKENCOIN_MANUAL_PROBE_COOLDOWN_SECONDS=30

# Optional OpenTelemetry export. Leave unset for local-only tracing.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
